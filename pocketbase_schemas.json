{
  "metadata": {
    "purpose": "PocketBase Real Schema & Architecture - Sistema Agri (ConAgri)",
    "last_updated": "2026-08-14",
    "critical_for": "Static typing, schema validation, zero-trust API contracts"
  },

  "critical_conventions": [
    "Collection names: 'Haciendas' (capital H), 'Siembras' (capital S), 'Zonas' (capital Z)",
    "Users role: select ['superadmin', 'administrador', 'auditor', 'operador', 'asesor']",
    "All JSON fields have max 2MB size limit",
    "Asesor store: 'asesor_productos' and 'asesor_pedidos' with automated ORD codes and state tracking"
  ],

  "collections": {
    "users_auth": {
      "id": "_pb_users_auth_",
      "type": "auth",
      "fields": {
        "username": "text (required, unique)",
        "name": "text (required)",
        "lastname": "text (required)",
        "email": "email (required, unique)",
        "role": "select ['superadmin', 'administrador', 'auditor', 'operador', 'asesor']",
        "hacienda": "relation to Haciendas (maxSelect: 1)",
        "avatar": "file (image)",
        "cedula": "text",
        "direccion": "text",
        "ciudad": "text",
        "pais": "text (ISO-2, default: 'EC')",
        "telefono": "text",
        "numero_colegiatura": "text",
        "especialidades": "json (array)",
        "zonas_cobertura": "json (array)",
        "bio_corta": "text",
        "info": "editor"
      }
    },

    "Haciendas": {
      "id": "hh6op9bbhdtkkf7",
      "fields": {
        "name": "text (required)",
        "location": "text",
        "pais": "text (ISO-2, default: 'EC')",
        "estado_provincia": "text",
        "gps": "json",
        "info": "editor",
        "plan": "relation to planes",
        "avatar": "file (image)",
        "ai_config": "json ({ provider, model, base_url, auth_token })",
        "status": "select ['active', 'suspended', 'inactive']",
        "suspension_reason": "text",
        "owner": "relation to users",
        "active_modules": "json (array of active module codes)",
        "contacto_email": "email",
        "contacto_telefono": "text"
      }
    },

    "planes": {
      "id": "k71wbkdxsz67mvy",
      "fields": {
        "nombre": "text (presentable)",
        "precio": "number",
        "operadores": "number",
        "auditores": "number"
      }
    },

    "asesor_productos": {
      "id": "pbc_asesor_productos",
      "fields": {
        "asesor": "relation to users (required)",
        "nombre": "text (required)",
        "categoria": "select ['fertilizantes', 'foliares', 'fitosanitarios', 'bioinsumos', 'semillas', 'herramientas', 'servicios_analisis', 'otros']",
        "descripcion": "text",
        "precio": "number (required)",
        "unidad_medida": "select ['litro', 'galon', 'caneca_20l', 'kg', 'saco_50kg', 'frasco_500ml', 'dosis_ha', 'unidad', 'servicio']",
        "stock_disponible": "number",
        "fotos": "file (maxSelect: 5)",
        "ficha_tecnica": "file (PDF)",
        "registro_fitosanitario": "text",
        "pais_origen": "text",
        "alcance_envio": "select ['local', 'regional', 'nacional', 'internacional']",
        "estados_envio_permitidos": "json (array)",
        "tiempo_entrega_dias": "number",
        "costo_envio_base": "number",
        "estado": "select ['activo', 'pausado', 'agotado', 'revision']",
        "visibilidad": "select ['publico', 'solo_vinculados']"
      }
    },

    "asesor_pedidos": {
      "id": "pbc_asesor_pedidos",
      "fields": {
        "codigo_orden": "text (unique, format: ORD-YYYY-XXXX)",
        "asesor": "relation to users (required)",
        "hacienda": "relation to Haciendas (required)",
        "comprador": "relation to users (required)",
        "items": "json (snapshot array)",
        "subtotal": "number (required)",
        "costo_envio": "number",
        "impuestos": "number",
        "total": "number (required)",
        "estado": "select ['pendiente_pago', 'pago_en_verificacion', 'pago_aprobado', 'en_preparacion', 'en_despacho', 'entregado', 'completado', 'cancelado', 'en_disputa']",
        "metodo_pago": "select ['transferencia', 'pasarela', 'credito_pactado']",
        "comprobante_pago": "file",
        "datos_entrega": "json",
        "guia_despacho": "file",
        "numero_guia": "text",
        "acta_recepcion_firma": "text (dataUrl / signature)",
        "ingreso_bodega_auto": "bool",
        "fechas_log": "json"
      }
    },

    "recetas": {
      "fields": {
        "asesor": "relation to users",
        "hacienda": "relation to Haciendas",
        "siembra": "relation to Siembras",
        "titulo": "text",
        "diagnostico": "editor",
        "prescripciones": "json",
        "estado": "select ['borrador', 'enviada', 'vista', 'aprobada', 'rechazada']",
        "firma_digital": "text",
        "fecha_envio": "date",
        "fecha_vista": "date"
      }
    },

    "vinculaciones_asesor": {
      "fields": {
        "asesor_id": "relation to users",
        "hacienda_id": "relation to Haciendas",
        "estado": "select ['activa', 'revocada', 'pendiente']",
        "fecha_vinculacion": "date"
      }
    },

    "bodega_movimientos": {
      "fields": {
        "hacienda": "relation to Haciendas",
        "producto": "text",
        "tipo_movimiento": "select ['ingreso', 'egreso', 'ajuste']",
        "cantidad": "number",
        "unidad": "text",
        "motivo": "text",
        "responsable": "relation to users"
      }
    },

    "nomina_semanas": {
      "fields": {
        "hacienda": "relation to Haciendas",
        "semana_inicio": "date",
        "semana_fin": "date",
        "estado": "select ['borrador', 'cerrada', 'pagada']",
        "total_pagado": "number",
        "detalles": "json"
      }
    },

    "tarjas": {
      "fields": {
        "hacienda": "relation to Haciendas",
        "siembra": "relation to Siembras",
        "zona": "relation to Zonas",
        "fecha": "date",
        "cantidad_cosechada": "number",
        "unidad": "text",
        "calidad": "text",
        "registrado_por": "relation to users"
      }
    }
  }
}
